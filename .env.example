# Database — kosong = SQLite lokal (file:./bla.db). Produksi: postgres://user:pass@host:5432/bla
DATABASE_URL=
# Wajib: string acak panjang (openssl rand -hex 32)
PAYLOAD_SECRET=
# URL publik situs (metadata, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Akun admin awal yang dibuat oleh `pnpm seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Email notifikasi lead (opsional — tanpa ini email hanya dicatat ke log)
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# Vercel (diisi otomatis oleh integrasi Neon & Blob; CRON_SECRET buat sendiri)
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
